+﻿param(
+    [switch]$Clean,
+    [string]$VcpkgRoot = ""
+)
+
+$ErrorActionPreference = "Stop"
+Set-StrictMode -Version Latest
+
+function Step([string]$Text) {
+    Write-Host ""
+    Write-Host "==> $Text" -ForegroundColor Cyan
+}
+
+function Fail([string]$Text) {
+    Write-Host ""
+    Write-Host "ERROR: $Text" -ForegroundColor Red
+    exit 1
+}
+
+$Root = Split-Path -Parent $MyInvocation.MyCommand.Path
+$BuildDir = Join-Path $Root "build-vs2022-sdu"
+$DistDir = Join-Path $Root "dist"
+$PluginDir = Join-Path $DistDir "SKSE\Plugins"
+$VoiceDir = Join-Path $DistDir "Sound\Voice\SilentDialogueUniversal"
+
+Push-Location $Root
+
+try {
+    Write-Host "SilentDialogueUniversal - VS2022 v143 build" -ForegroundColor Green
+    Write-Host "Project: $Root"
+
+    if (-not (Test-Path (Join-Path $Root "CMakeLists.txt"))) {
+        Fail "CMakeLists.txt was not found. Put this script in the SilentDialogueUniversal project root."
+    }
+
+    if (-not (Get-Command cmake.exe -ErrorAction SilentlyContinue)) {
+        Fail "cmake.exe was not found in PATH."
+    }
+
+    if (-not (Get-Command git.exe -ErrorAction SilentlyContinue)) {
+        Fail "git.exe was not found in PATH. It is required because CMake may fetch CommonLibSSE-NG and MinHook."
+    }
+
+    # vcpkg
+    if ($VcpkgRoot -and (Test-Path (Join-Path $VcpkgRoot "scripts\buildsystems\vcpkg.cmake"))) {
+        $env:VCPKG_ROOT = (Resolve-Path $VcpkgRoot).Path
+    }
+    elseif ($env:VCPKG_ROOT -and (Test-Path (Join-Path $env:VCPKG_ROOT "scripts\buildsystems\vcpkg.cmake"))) {
+        $env:VCPKG_ROOT = (Resolve-Path $env:VCPKG_ROOT).Path
+    }
+    elseif (Test-Path "C:\vcpkg\scripts\buildsystems\vcpkg.cmake") {
+        $env:VCPKG_ROOT = "C:\vcpkg"
+    }
+    else {
+        Fail 'vcpkg was not found. Run with -VcpkgRoot "C:\path\to\vcpkg".'
+    }
+
+    Write-Host "VCPKG_ROOT: $env:VCPKG_ROOT"
+
+    # Visual Studio 2022 Build Tools
+    $StandardVS2022 = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\2022\BuildTools"
+    $VcVars = Join-Path $StandardVS2022 "VC\Auxiliary\Build\vcvarsall.bat"
+
+    if (-not (Test-Path $VcVars)) {
+        Fail @"
+The registered VS2022 Build Tools instance was not found here:
+  $StandardVS2022
+
+Open Visual Studio Installer -> Build Tools 2022 -> Modify
+and ensure 'Desktop development with C++' is installed.
+"@
+    }
+
+    $Cl = Get-ChildItem -Path (Join-Path $StandardVS2022 "VC\Tools\MSVC") `
+        -Recurse -File -Filter "cl.exe" -ErrorAction SilentlyContinue |
+        Where-Object { $_.FullName -match '\\bin\\Hostx64\\x64\\cl\.exe$' } |
+        Sort-Object FullName -Descending |
+        Select-Object -First 1
+
+    if (-not $Cl) {
+        Fail "VS2022 Build Tools exists, but x64 cl.exe was not found."
+    }
+
+    $env:VCPKG_VISUAL_STUDIO_PATH = $StandardVS2022
+
+    Write-Host "Visual Studio 2022        : $StandardVS2022"
+    Write-Host "VCPKG_VISUAL_STUDIO_PATH : $env:VCPKG_VISUAL_STUDIO_PATH"
+    Write-Host "MSVC compiler             : $($Cl.FullName)"
+    Write-Host "vcpkg target triplet      : x64-windows-static-md"
+
+    if ($Clean -and (Test-Path $BuildDir)) {
+        Step "Removing previous build directory"
+        Remove-Item $BuildDir -Recurse -Force
+    }
+
+    Step "Configuring SilentDialogueUniversal"
+
+    $Toolchain = Join-Path $env:VCPKG_ROOT "scripts\buildsystems\vcpkg.cmake"
+
+    & cmake.exe `
+        -S $Root `
+        -B $BuildDir `
+        -G "Visual Studio 17 2022" `
+        -A x64 `
+        -T v143 `
+        "-DCMAKE_TOOLCHAIN_FILE=$Toolchain" `
+        "-DVCPKG_TARGET_TRIPLET=x64-windows-static-md" `
+        "-DVCPKG_HOST_TRIPLET=x64-windows"
+
+    if ($LASTEXITCODE -ne 0) {
+        Write-Host ""
+        Write-Host "CMake configuration failed." -ForegroundColor Red
+
+        $ManifestLog = Join-Path $BuildDir "vcpkg-manifest-install.log"
+        if (Test-Path $ManifestLog) {
+            Write-Host ""
+            Write-Host "Last lines of vcpkg-manifest-install.log:" -ForegroundColor Yellow
+            Get-Content $ManifestLog -Tail 120
+        }
+
+        Fail "Configuration failed with exit code $LASTEXITCODE."
+    }
+
+    Step "Compiling SilentDialogueUniversal (RelWithDebInfo)"
+
+    & cmake.exe --build $BuildDir --config RelWithDebInfo --target SilentDialogueUniversal --parallel
+
+    if ($LASTEXITCODE -ne 0) {
+        Fail "Compilation failed with exit code $LASTEXITCODE."
+    }
+
+    Step "Locating SilentDialogueUniversal.dll"
+
+    $Dll = Get-ChildItem -Path $BuildDir -Recurse -File -Filter "SilentDialogueUniversal.dll" -ErrorAction SilentlyContinue |
+        Where-Object { $_.FullName -notmatch '\\vcpkg_installed\\' } |
+        Sort-Object LastWriteTime -Descending |
+        Select-Object -First 1
+
+    if (-not $Dll) {
+        Fail "Build finished, but SilentDialogueUniversal.dll was not found."
+    }
+
+    if (Test-Path $DistDir) {
+        Remove-Item $DistDir -Recurse -Force
+    }
+
+    New-Item -ItemType Directory -Path $PluginDir -Force | Out-Null
+    Copy-Item $Dll.FullName (Join-Path $PluginDir "SilentDialogueUniversal.dll") -Force
+
+    $Pdb = Get-ChildItem -Path $BuildDir -Recurse -File -Filter "SilentDialogueUniversal.pdb" -ErrorAction SilentlyContinue |
+        Where-Object { $_.FullName -notmatch '\\vcpkg_installed\\' } |
+        Sort-Object LastWriteTime -Descending |
+        Select-Object -First 1
+
+    if ($Pdb) {
+        Copy-Item $Pdb.FullName (Join-Path $PluginDir "SilentDialogueUniversal.pdb") -Force
+    }
+
+    # Copy the plugin INI if present.
+    $Ini = Join-Path $Root "config\SilentDialogueUniversal.ini"
+    if (Test-Path $Ini) {
+        Copy-Item $Ini (Join-Path $PluginDir "SilentDialogueUniversal.ini") -Force
+    }
+    else {
+        Write-Host "WARNING: config\SilentDialogueUniversal.ini was not found." -ForegroundColor Yellow
+    }
+
+    # Reuse the already generated silent FUZ assets if they exist in the source package.
+    $SourceVoiceDir = Join-Path $Root "package\Sound\Voice\SilentDialogueUniversal"
+    if (Test-Path $SourceVoiceDir) {
+        $FuzFiles = Get-ChildItem -Path $SourceVoiceDir -File -Filter "silence_*.fuz" -ErrorAction SilentlyContinue
+        if ($FuzFiles) {
+            New-Item -ItemType Directory -Path $VoiceDir -Force | Out-Null
+            Copy-Item (Join-Path $SourceVoiceDir "silence_*.fuz") $VoiceDir -Force
+            Write-Host "Silent FUZ assets copied: $($FuzFiles.Count)"
+        }
+        else {
+            Write-Host "WARNING: No silence_*.fuz files were found in package\Sound\Voice\SilentDialogueUniversal." -ForegroundColor Yellow
+        }
+    }
+    else {
+        Write-Host "WARNING: No package\Sound\Voice\SilentDialogueUniversal directory found." -ForegroundColor Yellow
+        Write-Host "The DLL build is valid, but the release also needs the generated silence_1.fuz ... silence_10.fuz assets." -ForegroundColor Yellow
+    }
+
+    $FinalDll = Join-Path $PluginDir "SilentDialogueUniversal.dll"
+    $Hash = (Get-FileHash $FinalDll -Algorithm SHA256).Hash
+    $SizeKB = [math]::Round((Get-Item $FinalDll).Length / 1KB, 1)
+
+    Write-Host ""
+    Write-Host "============================================================" -ForegroundColor Green
+    Write-Host " BUILD SUCCESSFUL" -ForegroundColor Green
+    Write-Host "============================================================" -ForegroundColor Green
+    Write-Host "DLL   : $FinalDll"
+    Write-Host "Size  : $SizeKB KB"
+    Write-Host "SHA256: $Hash"
+
+    if ($Pdb) {
+        Write-Host "PDB   : $(Join-Path $PluginDir 'SilentDialogueUniversal.pdb')"
+    }
+
+    if (Test-Path (Join-Path $PluginDir "SilentDialogueUniversal.ini")) {
+        Write-Host "INI   : $(Join-Path $PluginDir 'SilentDialogueUniversal.ini')"
+    }
+
+    Write-Host ""
+    Write-Host "MO2-ready output:" -ForegroundColor Cyan
+    Write-Host "  $DistDir"
+}
+catch {
+    Write-Host ""
+    Write-Host "BUILD FAILED" -ForegroundColor Red
+    Write-Host $_.Exception.Message -ForegroundColor Red
+    exit 1
+}
+finally {
+    Pop-Location
+}
