{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Universal SE/AE Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [
        "SilentDialogueUniversal"
      ]
    }
  ]
}
